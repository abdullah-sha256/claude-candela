---
const links = [
  { href: '#collection', label: 'Collection' },
  { href: '#why', label: 'Why Partner' },
  { href: '#ordering', label: 'Ordering' },
]
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-paper/90 backdrop-blur transition-colors">
  <nav class="container-x flex h-16 items-center justify-between px-6" aria-label="Primary">
    <a href="#main" class="wordmark text-lg text-ink">OnlyCans</a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <a href={l.href} class="text-sm text-ink-soft transition-colors hover:text-ink">
            {l.label}
          </a>
        ))
      }
      <a href="#inquiry" class="btn btn-accent">Request Order Form</a>
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="-mr-2 p-2 text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden flex-col gap-1 border-t border-kraft bg-paper px-6 py-4 md:hidden">
    {
      links.map((l) => (
        <a href={l.href} class="rounded-md px-2 py-2.5 text-sm text-ink-soft hover:bg-paper-deep hover:text-ink">
          {l.label}
        </a>
      ))
    }
    <a href="#inquiry" class="btn btn-accent mt-2 justify-center">Request Order Form</a>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const menu = document.getElementById('mobile-menu')
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('flex')
      menu.classList.toggle('hidden')
      toggle.setAttribute('aria-expanded', String(open))
    })
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.add('hidden')
        menu.classList.remove('flex')
        toggle.setAttribute('aria-expanded', 'false')
      })
    )
  }
</script>
