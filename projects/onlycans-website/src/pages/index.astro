---
import Layout from '@/layouts/Layout.astro'
import Nav from '@/components/Nav.astro'
import ProductPhoto from '@/components/ProductPhoto.astro'
import InfoIcon from '@/components/InfoIcon.astro'
import InquiryForm from '@/components/InquiryForm.astro'
import {
  PRODUCTS,
  WHOLESALE_PRICE,
  RETAIL_PRICE,
  WHY_PARTNER,
  ORDERING_STATS,
  IMPORTANT_INFO,
  CONTACT_EMAIL,
  BUSINESS_ADDRESS,
  HST_NOTE,
} from '@/data/onlycans'

// Badge icon per SKU, for the mock illustration only — not part of the
// product data itself, since it's a presentational detail of the mock art.
const BADGE_ICON: Record<string, 'question' | 'flower' | 'herb' | 'paw'> = {
  'first-plant': 'question',
  flower: 'flower',
  herb: 'herb',
  catnip: 'paw',
}
---

<Layout>
  <Nav />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden px-6 pb-16 pt-32 md:pb-24 md:pt-44">
      <div
        class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[42rem] w-[42rem] -translate-x-1/2 -translate-y-1/3 rounded-full opacity-50 blur-3xl"
        style="background: radial-gradient(circle, var(--sprout-bright) 0%, transparent 62%);"
        aria-hidden="true"
      >
      </div>

      <div class="container-x">
        <p class="eyebrow">OnlyCans Presents · Wholesale · Toronto, Canada</p>
        <h1 class="mt-5 max-w-3xl text-balance text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl md:text-6xl">
          Grow in a Can.
        </h1>
        <p class="mt-2 text-lg font-medium text-ink-soft">Collection No. 01 · Wholesale Brochure</p>

        <p class="mt-6 max-w-xl text-pretty text-lg italic leading-relaxed text-ink-soft">
          "Not a drink. Not a toy. Not like anything else on your shelf."
        </p>
        <p class="mt-3 max-w-xl text-pretty leading-relaxed text-ink-soft">
          A real, living surprise hidden inside a familiar can — genuinely new for your shelf, and a
          gift every age group wants.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#inquiry" class="btn btn-accent">Request Order Form</a>
          <a href="#collection" class="btn btn-outline">See the collection</a>
        </div>
      </div>

      <div class="container-x mt-14">
        <div class="photo-tile w-full rounded-lg border border-kraft p-8">
          <p class="sr-only">The four Grow in a Can SKUs</p>
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
            {
              PRODUCTS.map((p) => (
                <ProductPhoto product={p} badge={BADGE_ICON[p.slug]!} class="h-auto w-full" />
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="section bg-paper-deep" id="about">
      <div class="container-x max-w-3xl">
        <p class="eyebrow">About Us</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">
          A gift that surprises first, and delights after.
        </h2>
        <div class="mt-6 space-y-5 leading-relaxed text-ink-soft">
          <p>
            OnlyCans is a Toronto-based novelty brand built around one idea: real, surprising things,
            hidden inside a can. <strong class="text-ink">Grow in a Can</strong> is our debut collection —
            real seeds and real soil, packed inside a can that looks like it belongs on a drink shelf.
            More collections are already in development, each bringing its own twist to the same idea:
            something genuine, hidden where you'd least expect it.
          </p>
          <p>
            The appeal is simple. A can on a shelf rarely earns a second look — until a customer
            realizes there's something living inside it. That moment of surprise is what turns a
            passing glance into a sale, and it's what makes Grow in a Can as satisfying to shelve as it
            is to give.
          </p>
          <p>
            It's also a genuine product, not a gag gift. The seeds inside actually grow, which is
            exactly what keeps customers coming back — for a birthday, a housewarming, or simply
            because.
          </p>
          <p>
            Every can is designed to work on its own: clear grow steps are printed right on the
            outside, and a seed-specific instruction card ships inside, matched to whichever variety
            that can contains. There's nothing extra for your staff to explain, and nothing for your
            customer to look up.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ WHY PARTNER ============ -->
    <section class="section" id="why">
      <div class="container-x">
        <p class="eyebrow">Why Partner With Us</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-bold leading-tight text-ink md:text-4xl">
          Nine reasons this earns shelf space.
        </h2>

        <div class="mt-14 grid gap-x-10 gap-y-10 md:grid-cols-2">
          {
            WHY_PARTNER.map((r) => (
              <div class="flex gap-4">
                <span class="shrink-0 font-display text-3xl font-bold text-sprout">{r.n}</span>
                <div>
                  <h3 class="text-lg font-semibold text-ink">{r.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{r.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ PRODUCTS ============ -->
    <section class="section bg-paper-deep" id="collection">
      <div class="container-x">
        <p class="eyebrow">Grow in a Can — The Products</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-bold leading-tight text-ink md:text-4xl">
          One signature 355 mL can, four reasons to pick it up.
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-ink-soft">
          Every SKU is priced the same, so building the assortment is one decision, not four.
        </p>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            PRODUCTS.map((p) => (
              <article class="flex flex-col rounded-lg border border-kraft bg-card p-6">
                <div class="photo-tile aspect-square w-full max-w-[180px] p-4">
                  <ProductPhoto product={p} badge={BADGE_ICON[p.slug]!} class="h-full w-full" />
                </div>
                <p class="mt-5 text-xs font-semibold uppercase tracking-[0.12em] text-sprout">
                  {p.badgeLabel}
                </p>
                <h3 class="mt-1 text-lg font-semibold text-ink">{p.name}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{p.blurb}</p>
                <div class="mt-5 flex items-baseline gap-2 border-t border-kraft pt-4">
                  <span class="text-lg font-bold text-ink">${RETAIL_PRICE}</span>
                  <span class="text-xs uppercase tracking-[0.1em] text-ink-soft">
                    retail ·
                    <span class="wholesale-figure">${WHOLESALE_PRICE} wholesale</span>
                    <a href="#inquiry" class="wholesale-locked-note underline decoration-dotted hover:text-sprout">
                      wholesale on request
                    </a>
                  </span>
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-10 rounded-lg border border-kraft bg-card p-5 text-sm leading-relaxed text-ink-soft">
          <strong class="text-ink">Two layers of instructions, every can:</strong> simple grow steps
          are printed right on the outside of the can, and a seed-specific "Grow Facts" card is sealed
          inside — matched to the exact seed that can received. Nothing left for your staff to explain.
        </div>
      </div>
    </section>

    <!-- ============ ORDERING ============ -->
    <section class="section" id="ordering">
      <div class="container-x max-w-3xl">
        <p class="eyebrow">Ordering With Us</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">
          Here's exactly what one order gets you.
        </h2>

        <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-kraft bg-kraft sm:grid-cols-3 lg:grid-cols-5">
          {
            ORDERING_STATS.map((s) => (
              <div class="bg-card p-5 text-center">
                <p class="text-[11px] uppercase tracking-[0.1em] text-ink-soft">{s.label}</p>
                <p class="mt-2 text-lg font-bold text-ink">
                  {'wholesale' in s && s.wholesale ? (
                    <>
                      <span class="wholesale-figure">{s.value}</span>
                      <a href="#inquiry" class="wholesale-locked-note text-sm font-normal underline decoration-dotted hover:text-sprout">
                        On request
                      </a>
                    </>
                  ) : (
                    s.value
                  )}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-8 leading-relaxed text-ink-soft">
          A full 4-SKU assortment, UPC-coded and shelf-ready, with a {((RETAIL_PRICE - WHOLESALE_PRICE) / RETAIL_PRICE * 100).toFixed(0)}% margin built in
          before you've sold a single can. Reorder only what moves — there's no minimum after your
          opening order, so nothing sits on your shelf because a supplier said it had to. And it isn't
          just a shipment: we'll help you plan the merchandising, from shelf placement to display
          setup, so it earns the spot it deserves. {HST_NOTE}
        </p>
        <p class="mt-4 leading-relaxed text-ink-soft">
          To place an opening order, request our Wholesale Order Form and we'll get your account set
          up.
        </p>

        <div class="mt-8 border-l-2 border-sprout pl-4 text-sm italic leading-relaxed text-ink-soft">
          <strong class="not-italic text-ink">What's next:</strong> Grow in a Can is Collection No. 01
          from OnlyCans. Retailers who stock it now will be first to hear about new collections as they
          launch.
        </div>

        <a href="#inquiry" class="btn btn-accent mt-8">Request the Wholesale Order Form</a>
      </div>
    </section>

    <!-- ============ IMPORTANT INFO ============ -->
    <section class="section bg-paper-deep">
      <div class="container-x">
        <p class="eyebrow">Important Information</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-bold leading-tight text-ink md:text-4xl">
          The practical details.
        </h2>

        <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            IMPORTANT_INFO.map((item) => (
              <div class="flex gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sprout/10 text-sprout">
                  <InfoIcon icon={item.icon} />
                </span>
                <div>
                  <h3 class="font-semibold text-ink">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{item.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ INQUIRY ============ -->
    <section class="section" id="inquiry">
      <div class="container-x max-w-2xl">
        <p class="eyebrow">Get In Touch</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-ink md:text-4xl">
          Request the Wholesale Order Form.
        </h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Tell us about your store and we'll get your account set up.
        </p>
        <div class="mt-10">
          <InquiryForm />
        </div>
      </div>
    </section>
  </main>

  <!-- ============ FOOTER ============ -->
  <footer class="border-t border-kraft bg-soil px-6 py-14 text-paper">
    <div class="container-x flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="wordmark text-lg text-paper">OnlyCans</p>
        <p class="mt-2 max-w-xs text-sm text-paper/70">Grow in a Can — Collection No. 01</p>
      </div>
      <div class="text-sm text-paper/70">
        <p>
          <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-paper">{CONTACT_EMAIL}</a>
        </p>
        <p class="mt-1">{BUSINESS_ADDRESS}</p>
      </div>
    </div>
  </footer>
</Layout>
