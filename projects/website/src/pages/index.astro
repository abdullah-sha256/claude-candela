---
import Layout from '@/layouts/Layout.astro'
import ProductImage from '@/components/ProductImage.astro'
import CollectionPhoto from '@/components/CollectionPhoto.astro'
import Lightbox from '@/components/Lightbox.astro'
import { Nav } from '@/components/Nav'
import { InquiryForm } from '@/components/InquiryForm'
import { buttonVariants } from '@/components/ui/button'
import {
  COLLECTIONS,
  COLLECTION_COUNT,
  CONTACT_EMAIL,
  FORMATS,
  SKU_COUNT,
  WHOLESALE_TERMS,
} from '@/data/collections'

const stats = [
  { value: `${SKU_COUNT}`, label: 'SKUs in production' },
  { value: `${COLLECTION_COUNT}`, label: 'Collections' },
  { value: '3', label: 'Vessel formats' },
  { value: '100%', label: 'Made in Canada' },
]

const reasons = [
  {
    title: 'Built to merchandise',
    body: 'Printed cans and message-forward jars read from across the room. The range was designed around what makes a customer pick something up, not around a fragrance list.',
  },
  {
    title: 'Gifting does the selling',
    body: 'Moments names the occasion, Travel names the place, Kawaii names the craving. Shoppers arrive already knowing who it is for — which is what moves units off a shelf.',
  },
  {
    title: 'Mix and match, low commitment',
    body: 'Every collection ships in cases of 12, freely mixed across scents — so no shelf is committing to a case of one. Reorders carry no minimum at all.',
  },
  {
    title: 'Short domestic lead times',
    body: 'Poured in Canada, so reorders are not sitting on a container. Testers available on request for any collection you carry.',
  },
]

// Each format is illustrated by one representative SKU — the collection
// carrying a `hero` code, falling back to the first SKU in that format.
const byFormat = (['jar', 'can', 'diffuser'] as const).map((f) => {
  const collections = COLLECTIONS.filter((c) => c.format === f)
  const withHero = collections.find((c) => c.hero)
  const heroSku =
    withHero?.skus.find((s) => s.code === withHero.hero) ?? collections[0]!.skus[0]!

  return { key: f, ...FORMATS[f], collections, heroSku }
})
---

<Layout>
  <Nav client:load />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="relative overflow-hidden px-6 pb-20 pt-32 md:pb-28 md:pt-44">
      <div
        class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[42rem] w-[42rem] -translate-x-1/2 -translate-y-1/3 rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(circle, var(--brass-bright) 0%, transparent 62%);"
        aria-hidden="true"
      >
      </div>

      <div class="container-x">
        <p class="eyebrow">Wholesale · Toronto, Canada</p>
        <h1
          class="mt-5 max-w-3xl text-balance text-4xl font-light leading-[1.08] tracking-tight text-espresso sm:text-5xl md:text-6xl"
        >
          Candles that earn their shelf space.
        </h1>
        <p class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-espresso-soft">
          Candela is a Toronto candle brand built for modern gifting and strong visual
          merchandising — {SKU_COUNT} SKUs across {COLLECTION_COUNT} collections, poured in Canada,
          with no per-scent minimums — build your own case.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#inquiry" class={buttonVariants({ variant: 'accent', size: 'lg' })}>
            Request a line sheet
          </a>
          <a href="#collections" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
            See the range
          </a>
        </div>

        <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-sand bg-sand md:grid-cols-4">
          {
            stats.map((s) => (
              <div class="bg-parchment px-5 py-6">
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display text-3xl text-espresso">{s.value}</span>
                  <span class="mt-1 block text-xs uppercase tracking-[0.12em] text-espresso-soft">
                    {s.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============ WHY ============ -->
    <section id="why" class="section bg-parchment-deep">
      <div class="container-x">
        <p class="eyebrow">Why buyers carry it</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-light leading-tight text-espresso md:text-4xl">
          The range is designed backwards from the shelf.
        </h2>

        <div class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2">
          {
            reasons.map((r, i) => (
              <div class="border-t border-sand pt-6">
                <span class="font-display text-sm text-brass">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-3 text-xl text-espresso">{r.title}</h3>
                <p class="mt-3 text-pretty leading-relaxed text-espresso-soft">{r.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ FORMATS ============ -->
    <section class="section">
      <div class="container-x">
        <p class="eyebrow">Formats</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-light leading-tight text-espresso md:text-4xl">
          Three vessels, three price tiers.
        </h2>

        <div class="mt-14 grid gap-8 md:grid-cols-3">
          {
            byFormat.map((f) => (
              <div class="rounded-lg border border-sand bg-card p-8">
                <div class="photo-tile aspect-[4/3] p-4">
                  <ProductImage
                    sku={f.heroSku.code}
                    name={f.heroSku.name}
                    format={f.key}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 768px) 340px, 88vw"
                    class="h-full w-full"
                  />
                </div>
                <h3 class="mt-6 text-xl text-espresso">{f.name}</h3>
                <p class="mt-1 text-xs uppercase tracking-[0.12em] text-brass">{f.spec}</p>
                <p class="mt-4 text-sm leading-relaxed text-espresso-soft">{f.blurb}</p>
                <p class="mt-5 border-t border-sand pt-4 text-sm text-espresso-soft">
                  {f.collections.map((c) => c.name).join(' · ')}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ COLLECTIONS ============ -->
    <section id="collections" class="section bg-parchment-deep">
      <div class="container-x">
        <p class="eyebrow">The range</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-light leading-tight text-espresso md:text-4xl">
          {COLLECTION_COUNT} collections, {SKU_COUNT} scents.
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-espresso-soft">
          Every collection ships in mix-and-match cases of 12. Build an assortment around one,
          or run the full wall.
        </p>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            COLLECTIONS.map((c) => (
              <article class="flex flex-col overflow-hidden rounded-lg border border-sand bg-card transition-colors hover:border-brass/50">
                <div class="photo-tile aspect-[3/1] w-full">
                  <CollectionPhoto slug={c.slug} name={c.name} class="h-full w-full" />
                </div>

                <div class="flex flex-1 flex-col p-7">
                <h3 class="text-xl text-espresso">{c.name}</h3>
                <p class="mt-1 text-xs uppercase tracking-[0.12em] text-espresso-soft">
                  {c.skus.length > 1 && `${c.skus.length} scents · `}
                  {FORMATS[c.format].name}
                </p>

                <p class="mt-5 text-sm leading-relaxed text-espresso-soft">{c.description}</p>

                <p class="mt-4 border-l-2 border-brass/40 pl-3 text-sm italic text-espresso-soft">
                  {c.pitch}
                </p>

                <div class="mt-5 border-t border-sand pt-4">
                  <span class="text-lg text-espresso">${c.msrp.toFixed(2)}</span>
                  <span class="text-xs uppercase tracking-[0.12em] text-espresso-soft">MSRP</span>
                  <p class="mt-1 text-xs text-espresso-soft">
                    <a href="#inquiry" class="underline decoration-dotted hover:text-brass">
                      Email us for wholesale pricing
                    </a>
                  </p>
                </div>
                <p class="mt-1 text-xs text-espresso-soft">{c.casePack}</p>

                {/* Single-product collections (Atelier, Pop) show the product on
                    its own — a one-tile grid captioned with the collection name
                    would just repeat the heading. */}
                {c.skus.length === 1 ? (
                  <div class="mt-6 border-t border-sand pt-6">
                    <div class="photo-tile mx-auto aspect-square w-2/3 p-3">
                      <ProductImage
                        sku={c.skus[0]!.code}
                        name={c.name}
                        format={c.format}
                        widths={[240, 480, 720]}
                        sizes="(min-width: 1024px) 220px, (min-width: 768px) 200px, 55vw"
                        class="h-full w-full"
                      />
                    </div>
                  </div>
                ) : (
                  <ul class="mt-6 grid grid-cols-3 gap-x-3 gap-y-5 border-t border-sand pt-6">
                    {c.skus.map((s) => (
                      <li>
                        <div class="photo-tile aspect-square p-2">
                          <ProductImage
                            sku={s.code}
                            name={s.name}
                            format={c.format}
                            sizes="(min-width: 1024px) 100px, (min-width: 768px) 140px, 26vw"
                            class="h-full w-full"
                          />
                        </div>
                        <p class="mt-2 text-center text-xs leading-snug text-espresso-soft">
                          {s.name}
                        </p>
                      </li>
                    ))}
                  </ul>
                )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ WHOLESALE TERMS ============ -->
    <section id="wholesale" class="section bg-wick text-parchment">
      <div class="container-x grid gap-16 lg:grid-cols-2">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-brass-bright">
            The programme
          </p>
          <h2 class="mt-4 text-3xl font-light leading-tight md:text-4xl">
            Straightforward to stock.
          </h2>
          <p class="mt-6 max-w-md text-pretty leading-relaxed text-parchment/70">
            A $250 opening order, no reorder minimum, and no exclusivity strings. Request the
            line sheet below for full SKU-level detail and current stock.
          </p>

          <a href="#inquiry" class={buttonVariants({ variant: 'onDark', size: 'lg' }) + ' mt-8'}>
            Request a line sheet
          </a>
        </div>

        <dl class="divide-y divide-parchment/15 border-y border-parchment/15">
          {
            WHOLESALE_TERMS.map((t) => (
              <div class="flex items-baseline justify-between gap-8 py-4">
                <dt class="text-xs uppercase tracking-[0.14em] text-parchment/50">{t.term}</dt>
                <dd class="text-right text-parchment">{t.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============ INQUIRY ============ -->
    <section id="inquiry" class="section">
      <div class="container-x grid gap-14 lg:grid-cols-[0.8fr_1fr]">
        <div>
          <p class="eyebrow">Get in touch</p>
          <h2 class="mt-4 text-3xl font-light leading-tight text-espresso md:text-4xl">
            Request the line sheet.
          </h2>
          <p class="mt-6 text-pretty leading-relaxed text-espresso-soft">
            Tell us a little about your shop and we will send the current wholesale line sheet
            with pricing, minimums, and available stock.
          </p>
          <p class="mt-8 border-t border-sand pt-6 text-sm text-espresso-soft">
            Prefer email?{' '}
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="text-brass underline underline-offset-4 hover:text-brass-bright"
            >
              {CONTACT_EMAIL}
            </a>
          </p>
        </div>

        <div class="rounded-lg border border-sand bg-parchment-deep p-7 md:p-9">
          <InquiryForm client:visible />
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-sand px-6 py-12">
    <div class="container-x flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="wordmark text-base text-espresso">candēla</p>
        <p class="mt-2 text-sm text-espresso-soft">
          Scented soy candles · bougies de soja parfumées
        </p>
      </div>
      <p class="text-sm text-espresso-soft">
        Made in Canada · Toronto, ON ·{' '}
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="hover:text-espresso hover:underline hover:underline-offset-4"
        >
          {CONTACT_EMAIL}
        </a>
      </p>
    </div>
  </footer>

  <Lightbox />
</Layout>
