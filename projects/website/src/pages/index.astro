---
import Layout from '@/layouts/Layout.astro'
import ProductImage from '@/components/ProductImage.astro'
import CollectionPhoto from '@/components/CollectionPhoto.astro'
import Lightbox from '@/components/Lightbox.astro'
import { Nav } from '@/components/Nav'
import { InquiryForm } from '@/components/InquiryForm'
import { buttonVariants } from '@/components/ui/button'
import {
  COLLECTIONS,
  COLLECTION_COUNT,
  CONTACT_EMAIL,
  FORMATS,
  SKU_COUNT,
  WHOLESALE_TERMS,
} from '@/data/collections'

const stats = [
  { value: `${SKU_COUNT}`, label: 'SKUs in production' },
  { value: `${COLLECTION_COUNT}`, label: 'Collections' },
  { value: '3', label: 'Vessel formats' },
  { value: '100%', label: 'Made in Canada' },
]

const reasons = [
  {
    title: 'Built to merchandise',
    body: 'Printed cans and message-forward jars read from across the room. The range was designed around what makes a customer pick something up, not around a fragrance list.',
  },
  {
    title: 'Gifting does the selling',
    body: 'Moments names the occasion, Travel names the place, Kawaii names the craving. Shoppers arrive already knowing who it is for — which is what moves units off a shelf.',
  },
  {
    title: 'Mix and match, low commitment',
    body: 'Every collection ships in cases of 12, freely mixed across scents — so no shelf is committing to a case of one. Reorders carry no minimum at all.',
  },
  {
    title: 'Short domestic lead times',
    body: 'Poured in Canada, so reorders are not sitting on a container. Testers available on request for any collection you carry.',
  },
]

// Each format is illustrated by one representative SKU — the collection
// carrying a `hero` code, falling back to the first SKU in that format.
const byFormat = (['jar', 'can', 'diffuser'] as const).map((f) => {
  const collections = COLLECTIONS.filter((c) => c.format === f)
  const withHero = collections.find((c) => c.hero)
  const heroSku =
    withHero?.skus.find((s) => s.code === withHero.hero) ?? collections[0]!.skus[0]!

  return { key: f, ...FORMATS[f], collections, heroSku }
})
---

<Layout>
  <Nav client:load />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="px-6 pb-16 pt-32 md:pb-24 md:pt-48">
      <div class="container-x">
        <p class="eyebrow">Wholesale · Toronto, Canada</p>
        <h1
          class="mt-6 max-w-4xl text-balance text-5xl font-light leading-[1.02] tracking-tight text-ink sm:text-6xl md:text-7xl lg:text-8xl"
        >
          Candles that <span class="display-accent">earn</span> their shelf space.
        </h1>

        <div class="mt-12 flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
          <p class="max-w-xl text-pretty text-lg leading-relaxed text-ink-soft">
            Candela is a Toronto candle brand built for modern gifting and strong visual
            merchandising — {SKU_COUNT} SKUs across {COLLECTION_COUNT} collections, poured in
            Canada, with no per-scent minimums.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <a href="#inquiry" class={buttonVariants({ variant: 'accent', size: 'lg' })}>
              Request a line sheet
            </a>
            <a href="#collections" class={buttonVariants({ variant: 'outline', size: 'lg' })}>
              See the range
            </a>
          </div>
        </div>

        <dl class="mt-16 grid grid-cols-2 border-t border-ink/60 md:grid-cols-4">
          {
            stats.map((s) => (
              <div class="border-b border-line py-6 pr-6 md:border-b-0">
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="font-display text-4xl font-light text-ink md:text-5xl">
                    {s.value}
                  </span>
                  <span class="mt-2 block text-[0.7rem] uppercase tracking-[0.16em] text-ink-soft">
                    {s.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============ WHY ============ -->
    <section id="why" class="section border-t border-line">
      <div class="container-x">
        <div class="grid gap-12 lg:grid-cols-[0.9fr_2fr]">
          <div>
            <p class="eyebrow">Why buyers carry it</p>
            <h2 class="mt-4 text-3xl font-light leading-tight text-ink md:text-4xl">
              Designed backwards from the <span class="display-accent">shelf</span>.
            </h2>
          </div>

          <div class="grid gap-x-14 gap-y-12 sm:grid-cols-2">
            {
              reasons.map((r, i) => (
                <div>
                  <span class="font-display text-5xl font-light text-terracotta/70">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-4 text-xl text-ink">{r.title}</h3>
                  <p class="mt-3 text-pretty leading-relaxed text-ink-soft">{r.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FORMATS ============ -->
    <section class="section border-t border-line bg-paper-deep">
      <div class="container-x">
        <p class="eyebrow">Formats</p>
        <h2 class="mt-4 max-w-2xl text-3xl font-light leading-tight text-ink md:text-4xl">
          Three vessels, three price tiers.
        </h2>

        <div class="mt-14 grid gap-x-10 gap-y-14 md:grid-cols-3">
          {
            byFormat.map((f) => (
              <div>
                <div class="photo-tile aspect-[4/3] p-5">
                  <ProductImage
                    sku={f.heroSku.code}
                    name={f.heroSku.name}
                    format={f.key}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 768px) 340px, 88vw"
                    class="h-full w-full"
                  />
                </div>
                <div class="mt-6 border-t border-ink/60 pt-5">
                  <div class="flex items-baseline justify-between gap-4">
                    <h3 class="text-2xl font-light text-ink">{f.name}</h3>
                    <p class="text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft">
                      {f.spec}
                    </p>
                  </div>
                  <p class="mt-4 text-sm leading-relaxed text-ink-soft">{f.blurb}</p>
                  <p class="mt-4 text-xs uppercase tracking-[0.12em] text-terracotta">
                    {f.collections.map((c) => c.name).join(' · ')}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ COLLECTIONS ============ -->
    <section id="collections" class="section border-t border-line">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
          <div>
            <p class="eyebrow">The range</p>
            <h2 class="mt-4 max-w-2xl text-3xl font-light leading-tight text-ink md:text-4xl">
              {COLLECTION_COUNT} collections, <span class="display-accent">{SKU_COUNT}</span> scents.
            </h2>
          </div>
          <p class="max-w-sm text-sm leading-relaxed text-ink-soft">
            Every collection ships in mix-and-match cases of 12. Build an assortment around
            one, or run the full wall.
          </p>
        </div>

        <div class="mt-16 flex flex-col gap-20 md:gap-24">
          {
            COLLECTIONS.map((c, i) => (
              <article class="grid items-start gap-8 border-t border-ink/60 pt-10 lg:grid-cols-2 lg:gap-14">
                <div class:list={['lg:sticky lg:top-24', i % 2 === 1 && 'lg:order-2']}>
                  <div class="photo-tile aspect-[16/9] w-full">
                    <CollectionPhoto slug={c.slug} name={c.name} class="h-full w-full" />
                  </div>
                </div>

                <div class:list={[i % 2 === 1 && 'lg:order-1']}>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                    <h3 class="text-3xl font-light text-ink md:text-4xl">{c.name}</h3>
                    <p class="text-[0.7rem] uppercase tracking-[0.16em] text-ink-soft">
                      {c.skus.length > 1 && `${c.skus.length} scents · `}
                      {FORMATS[c.format].name}
                    </p>
                  </div>

                  <p class="mt-5 leading-relaxed text-ink-soft">{c.description}</p>

                  <p class="mt-4 font-display text-lg italic leading-relaxed text-terracotta">
                    {c.pitch}
                  </p>

                  <div class="mt-6 flex flex-wrap items-baseline gap-x-8 gap-y-2 border-t border-line pt-5">
                    <p>
                      <span class="font-display text-2xl font-light text-ink">
                        ${c.msrp.toFixed(2)}
                      </span>
                      <span class="ml-2 text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft">
                        MSRP
                      </span>
                    </p>
                    <p class="text-xs text-ink-soft">{c.casePack}</p>
                    <p class="text-xs text-ink-soft">
                      <a
                        href="#inquiry"
                        class="underline decoration-dotted underline-offset-4 hover:text-terracotta"
                      >
                        Email us for wholesale pricing
                      </a>
                    </p>
                  </div>

                  {/* Single-product collections (Atelier, Pop) show the product on
                      its own — a one-tile grid captioned with the collection name
                      would just repeat the heading. */}
                  {c.skus.length === 1 ? (
                    <div class="mt-8">
                      <div class="photo-tile aspect-square w-40 p-3">
                        <ProductImage
                          sku={c.skus[0]!.code}
                          name={c.name}
                          format={c.format}
                          widths={[240, 480, 720]}
                          sizes="160px"
                          class="h-full w-full"
                        />
                      </div>
                    </div>
                  ) : (
                    <ul class="mt-8 grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-5">
                      {c.skus.map((s) => (
                        <li>
                          <div class="photo-tile aspect-square p-2">
                            <ProductImage
                              sku={s.code}
                              name={s.name}
                              format={c.format}
                              sizes="(min-width: 640px) 110px, 28vw"
                              class="h-full w-full"
                            />
                          </div>
                          <p class="mt-2 text-center text-xs leading-snug text-ink-soft">
                            {s.name}
                          </p>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ WHOLESALE TERMS ============ -->
    <section id="wholesale" class="section bg-wick text-cream">
      <div class="container-x grid gap-16 lg:grid-cols-2">
        <div>
          <p class="text-xs font-medium uppercase tracking-[0.22em] text-terracotta-bright">
            The programme
          </p>
          <h2 class="mt-4 text-3xl font-light leading-tight md:text-4xl">
            Straightforward to <span class="font-display italic">stock</span>.
          </h2>
          <p class="mt-6 max-w-md text-pretty leading-relaxed text-cream/70">
            A $250 opening order, no reorder minimum, and no exclusivity strings. Request the
            line sheet below for full SKU-level detail and current stock.
          </p>

          <a href="#inquiry" class={buttonVariants({ variant: 'onDark', size: 'lg' }) + ' mt-8'}>
            Request a line sheet
          </a>
        </div>

        <dl class="divide-y divide-cream/15 border-y border-cream/15">
          {
            WHOLESALE_TERMS.map((t) => (
              <div class="flex items-baseline justify-between gap-8 py-4">
                <dt class="text-xs uppercase tracking-[0.14em] text-cream/50">{t.term}</dt>
                <dd class="text-right text-cream">{t.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============ INQUIRY ============ -->
    <section id="inquiry" class="section">
      <div class="container-x grid gap-14 lg:grid-cols-[0.8fr_1fr]">
        <div>
          <p class="eyebrow">Get in touch</p>
          <h2 class="mt-4 text-3xl font-light leading-tight text-ink md:text-4xl">
            Request the <span class="display-accent">line sheet</span>.
          </h2>
          <p class="mt-6 text-pretty leading-relaxed text-ink-soft">
            Tell us a little about your shop and we will send the current wholesale line sheet
            with pricing, minimums, and available stock.
          </p>
          <p class="mt-8 border-t border-line pt-6 text-sm text-ink-soft">
            Prefer email?{' '}
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="text-terracotta underline underline-offset-4 hover:text-terracotta-bright"
            >
              {CONTACT_EMAIL}
            </a>
          </p>
        </div>

        <div class="border-t border-ink/60 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
          <InquiryForm client:visible />
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line px-6 py-12">
    <div class="container-x flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div>
        <p class="wordmark text-base text-ink">candēla</p>
        <p class="mt-2 text-sm text-ink-soft">
          Scented soy candles · bougies de soja parfumées
        </p>
      </div>
      <p class="text-sm text-ink-soft">
        Made in Canada · Toronto, ON ·{' '}
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="hover:text-ink hover:underline hover:underline-offset-4"
        >
          {CONTACT_EMAIL}
        </a>
      </p>
    </div>
  </footer>

  <Lightbox />
</Layout>
